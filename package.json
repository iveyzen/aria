{
  "name": "aria",
  "version": "0.1.0",
  "description": "Aria — a desktop companion AI that sees your screen and talks (OpenAI gpt-realtime-2.1)",
  "main": "dist/main/main.js",
  "license": "MIT",
  "scripts": {
